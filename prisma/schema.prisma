generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Rental {
  id                Int      @id @default(autoincrement())
  propertyName      String
  address           String
  city              String
  monthlyRent       Float
  status            String   @default("Interested")
  listingUrl        String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  viewingDate       DateTime?
  applicationDeadline DateTime?
  submittedAt       DateTime?
  documentNotes     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rentals Rental[]
}

