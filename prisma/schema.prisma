generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rental {
  id           Int      @id @default(autoincrement())
  propertyName String
  address      String
  city         String
  monthlyRent  Float
  status       String   @default("Interested")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}